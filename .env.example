# Local development environment. Copy to .env: `cp .env.example .env`
# Loaded by dotenvx (`dotenvx run`). To commit secrets safely instead, encrypt with
# `pnpm exec dotenvx encrypt` and keep .env.keys out of git (already ignored).

# --- Database (packages/db, apps/api) ---
DATABASE_URL=postgresql://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app_test

# --- API (apps/api) ---
PORT=3000
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
# The user's time zone: today's date, workout dates and Monday-start weeks.
APP_TIMEZONE=America/Chicago
# Auth (WorkOS AuthKit). Leave empty to develop with test sign-in only (see AUTH_TEST_SECRET).
# Dashboard: Developer > API Keys (client ID and API key); Authentication > AuthKit (domain).
# Web sign-in runs on the API, which keeps the session in an HttpOnly cookie.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Encrypts the session cookie: at least 32 random characters (e.g. `openssl rand -base64 32`).
WORKOS_COOKIE_PASSWORD=
# The web app's public URL: the browser reaches the API through it at /api.
WEB_URL=http://localhost:5173
AUTHKIT_DOMAIN=
# Public URL of the MCP endpoint; must match a Resource Indicator in the WorkOS dashboard.
MCP_RESOURCE_URL=http://localhost:3000/mcp
# Optional comma-separated WorkOS user IDs (user_...) allowed to use the app. Empty: anyone.
ALLOWED_USER_IDS=
# Development/test only (refused in production): accept locally signed test tokens.
AUTH_TEST_SECRET=dev-only-test-secret-change-me-0123456789
# Sentry is disabled while the DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# --- Web (apps/web). Only VITE_* variables are exposed to the browser. ---
# Where the browser calls the API: /api on the web app's own origin (Vite proxies it to
# API_PROXY_TARGET, default http://localhost:3000), so the session cookie is first-party.
VITE_API_URL=/api
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
