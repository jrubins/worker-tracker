{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "dotenvx run -q -f ../../.env --ignore=MISSING_ENV_FILE -- node --watch --watch-preserve-output src/server.ts",
    "start": "node src/server.ts",
    "test": "dotenvx run -q -f ../../.env --ignore=MISSING_ENV_FILE -- vitest run",
    "build": "node scripts/build-vercel.ts"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@app/shared": "workspace:*",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/node": "11.16.0",
    "@vercel/functions": "3.11.3",
    "@workos-inc/node": "12.4.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "@vercel/nft": "1.11.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "vitest": "catalog:"
  }
}
